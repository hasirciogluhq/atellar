# Atellar control plane (cmd/api)
#
# Local dev:  export $(grep -v '^#' cmd/api/.env.example | xargs) && go run ./cmd/api
# Docker:     docker compose up --build
# Or:         docker build -f cmd/api/Dockerfile -t atellar-api .
#             docker run --env-file cmd/api/.env.example -p 8080:8080 -p 9090:9090 atellar-api
# Systemd:    atelctl server install writes /etc/atellar/api.env (see docs/cli.md)

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atellar_cp?sslmode=disable

# HTTP / gRPC
PORT=8080
GRPC_PORT=9090

# Migrations
# Local dev:  ./internal/db/migrations
# Release:    /usr/share/atellar/migrations
MIGRATIONS_PATH=./internal/db/migrations

# Overlay IPAM
CLUSTER_OVERLAY_CIDR=10.0.0.0/8
NODE_SUBNET_PREFIX_LEN=24
